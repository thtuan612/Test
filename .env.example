# Discord channel webhook URL. Keep this secret; never commit a real webhook.
DISCORD_WEBHOOK_URL=
# Poll every 300 seconds (5 minutes); minimum enforced is 60 seconds.
CHECK_INTERVAL_SECONDS=300
# Optional: on Railway, point this to a persistent Volume mount, e.g. /data/giftcodes.sqlite3
DATABASE_PATH=data/giftcodes.sqlite3
LOG_LEVEL=INFO
